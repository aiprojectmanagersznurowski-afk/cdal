{
  "name": "cdal",
  "version": "0.1.0",
  "description": "Command-line interface and hook router for CDAL (Contract-Driven Agentic Loop)",
  "type": "module",
  "bin": {
    "cdal": "./bin/cdal.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "bin"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cdal/adapters": "workspace:*",
    "@cdal/audit": "workspace:*",
    "@cdal/core": "workspace:*",
    "@cdal/kinds": "workspace:*",
    "@clack/prompts": "^0.9.1",
    "citty": "^0.1.6",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.10"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
