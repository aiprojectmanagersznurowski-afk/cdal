{
  "name": "cdalkit",
  "version": "0.1.4",
  "description": "Command-line interface and hook router for CDAL (Contract-Driven Agentic Loop)",
  "license": "Apache-2.0",
  "author": "Michał Sznurowski",
  "homepage": "https://cdal-henna.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiprojectmanagersznurowski-afk/cdal.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/aiprojectmanagersznurowski-afk/cdal/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "cursor",
    "windsurf",
    "antigravity",
    "quality-gates",
    "contracts",
    "testing",
    "vibecoding"
  ],
  "type": "module",
  "bin": {
    "cdal": "./bin/cdal.mjs",
    "cdalkit": "./bin/cdal.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "bin"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cdal/adapters": "workspace:*",
    "@cdal/audit": "workspace:*",
    "@cdal/core": "workspace:*",
    "@cdal/kinds": "workspace:*",
    "@clack/prompts": "^0.9.1",
    "citty": "^0.1.6",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.10"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
