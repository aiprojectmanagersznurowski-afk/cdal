{
  "name": "cdal-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Contract-Driven Agentic Loop (CDAL) - Quality gates and auditability for AI-written code",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "cdal": "node ./packages/cli/bin/cdal.mjs",
    "docs:cli": "node scripts/gen-cli-docs.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@cdal/adapters": "workspace:*",
    "@cdal/core": "workspace:*",
    "@cdal/kinds": "workspace:*",
    "cdal": "workspace:*",
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "^2.27.12",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.2.7",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  }
}
